# ---- Provider selection --------------------------------------------------
# 'ollama' runs entirely on your own machine and needs no API key.
# 'openai' uses the hosted API and needs OPENAI_API_KEY.
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama

# Leave EMBEDDING_DIM commented out to resolve it automatically from the model.
# Only set it for a model this project does not know about.
#   text-embedding-3-small -> 1536   nomic-embed-text  -> 768
#   text-embedding-3-large -> 3072   mxbai-embed-large -> 1024
#   all-minilm             -> 384    bge-m3            -> 1024
# EMBEDDING_DIM=768

# ---- Ollama (local, default) ---------------------------------------------
#   ollama serve
#   ollama pull nomic-embed-text
#   ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# ---- OpenAI (hosted, optional) -------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
# Set OPENAI_BASE_URL only for an OpenAI-compatible gateway such as vLLM or LiteLLM.
OPENAI_BASE_URL=

# ---- Milvus --------------------------------------------------------------
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_chunks
MILVUS_METRIC_TYPE=COSINE
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_HNSW_EF_SEARCH=64

# ---- ChromaDB (legacy, migration source only) ----------------------------
CHROMA_PATH=./.chroma
CHROMA_COLLECTION=rag_chunks
