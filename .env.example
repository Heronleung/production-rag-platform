# ---- Embeddings ----------------------------------------------------------
# EMBEDDING_DIM must match the model. Getting this wrong only fails at insert
# time, because the Milvus collection schema is fixed once created.
#   text-embedding-3-small -> 1536
#   text-embedding-3-large -> 3072
#   BAAI/bge-m3            -> 1024
OPENAI_API_KEY=sk-replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Milvus --------------------------------------------------------------
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_chunks
MILVUS_METRIC_TYPE=COSINE
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_HNSW_EF_SEARCH=64

# ---- ChromaDB (legacy, migration source only) ----------------------------
CHROMA_PATH=./.chroma
CHROMA_COLLECTION=rag_chunks
