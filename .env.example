# ---- Provider selection --------------------------------------------------
# Embeddings remain fixed for a Milvus collection. The UI can switch only the
# chat provider per query without re-ingesting stored documents.
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama

# Leave EMBEDDING_DIM commented out to resolve known models automatically.
# EMBEDDING_DIM=768

# ---- Ollama (local default) ----------------------------------------------
# ollama serve
# ollama pull nomic-embed-text
# ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# ---- Hosted chat providers ----------------------------------------------
# Keys are read only by FastAPI. Never prefix them with NEXT_PUBLIC_ and never
# commit real values. The browser sends provider and model names only.
HOSTED_LLM_TIMEOUT_SECONDS=120

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-chat

# ---- Milvus --------------------------------------------------------------
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_chunks
MILVUS_METRIC_TYPE=COSINE
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_HNSW_EF_SEARCH=64

# ---- ChromaDB (legacy migration source only) -----------------------------
CHROMA_PATH=./.chroma
CHROMA_COLLECTION=rag_chunks
